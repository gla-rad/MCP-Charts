{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "MCP VPC - 3 public + 3 private subnets across eu-west-2a/b/c, single NAT gateway. Reconstructed from live account 322828184358 (vpc-0b75a97743d9bca29) and adjusted for EKS readiness.",

  "Parameters": {
    "ClusterName": {
      "Type": "String",
      "Default": "mcp",
      "Description": "EKS cluster name. Used to build the kubernetes.io/cluster/<name> subnet tags."
    },
    "VpcCidr": {
      "Type": "String",
      "Default": "10.1.0.0/16",
      "Description": "CIDR block for the VPC."
    },
    "PublicSubnet1Cidr": { "Type": "String", "Default": "10.1.0.0/20" },
    "PublicSubnet2Cidr": { "Type": "String", "Default": "10.1.16.0/20" },
    "PublicSubnet3Cidr": { "Type": "String", "Default": "10.1.32.0/20" },
    "PrivateSubnet1Cidr": { "Type": "String", "Default": "10.1.128.0/19" },
    "PrivateSubnet2Cidr": { "Type": "String", "Default": "10.1.160.0/19" },
    "PrivateSubnet3Cidr": { "Type": "String", "Default": "10.1.192.0/19" }
  },

  "Resources": {

    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": { "Ref": "VpcCidr" },
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "InstanceTenancy": "default",
        "Tags": [{ "Key": "Name", "Value": "mcp-vpc" }]
      }
    },

    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [{ "Key": "Name", "Value": "mcp-internet-gateway" }]
      }
    },

    "InternetGatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "InternetGatewayId": { "Ref": "InternetGateway" }
      }
    },

    "PublicSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "CidrBlock": { "Ref": "PublicSubnet1Cidr" },
        "AvailabilityZone": { "Fn::Select": [0, { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          { "Key": "Name", "Value": "MCP Public Subnet 1" },
          { "Key": "Type", "Value": "public" },
          { "Key": "kubernetes.io/role/elb", "Value": "1" },
          { "Key": { "Fn::Sub": "kubernetes.io/cluster/${ClusterName}" }, "Value": "shared" }
        ]
      }
    },

    "PublicSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "CidrBlock": { "Ref": "PublicSubnet2Cidr" },
        "AvailabilityZone": { "Fn::Select": [1, { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          { "Key": "Name", "Value": "MCP Public Subnet 2" },
          { "Key": "Type", "Value": "public" },
          { "Key": "kubernetes.io/role/elb", "Value": "1" },
          { "Key": { "Fn::Sub": "kubernetes.io/cluster/${ClusterName}" }, "Value": "shared" }
        ]
      }
    },

    "PublicSubnet3": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "CidrBlock": { "Ref": "PublicSubnet3Cidr" },
        "AvailabilityZone": { "Fn::Select": [2, { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          { "Key": "Name", "Value": "MCP Public Subnet 3" },
          { "Key": "Type", "Value": "public" },
          { "Key": "kubernetes.io/role/elb", "Value": "1" },
          { "Key": { "Fn::Sub": "kubernetes.io/cluster/${ClusterName}" }, "Value": "shared" }
        ]
      }
    },

    "PrivateSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "CidrBlock": { "Ref": "PrivateSubnet1Cidr" },
        "AvailabilityZone": { "Fn::Select": [0, { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          { "Key": "Name", "Value": "MCP Private Subnet 1" },
          { "Key": "Type", "Value": "private" },
          { "Key": "kubernetes.io/role/internal-elb", "Value": "1" },
          { "Key": { "Fn::Sub": "kubernetes.io/cluster/${ClusterName}" }, "Value": "shared" }
        ]
      }
    },

    "PrivateSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "CidrBlock": { "Ref": "PrivateSubnet2Cidr" },
        "AvailabilityZone": { "Fn::Select": [1, { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          { "Key": "Name", "Value": "MCP Private Subnet 2" },
          { "Key": "Type", "Value": "private" },
          { "Key": "kubernetes.io/role/internal-elb", "Value": "1" },
          { "Key": { "Fn::Sub": "kubernetes.io/cluster/${ClusterName}" }, "Value": "shared" }
        ]
      }
    },

    "PrivateSubnet3": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "CidrBlock": { "Ref": "PrivateSubnet3Cidr" },
        "AvailabilityZone": { "Fn::Select": [2, { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          { "Key": "Name", "Value": "MCP Private Subnet 3" },
          { "Key": "Type", "Value": "private" },
          { "Key": "kubernetes.io/role/internal-elb", "Value": "1" },
          { "Key": { "Fn::Sub": "kubernetes.io/cluster/${ClusterName}" }, "Value": "shared" }
        ]
      }
    },

    "NatEip": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "InternetGatewayAttachment",
      "Properties": {
        "Domain": "vpc",
        "Tags": [{ "Key": "Name", "Value": "mcp-nat-eip" }]
      }
    },

    "NatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": { "Fn::GetAtt": ["NatEip", "AllocationId"] },
        "SubnetId": { "Ref": "PublicSubnet1" },
        "ConnectivityType": "public",
        "Tags": [{ "Key": "Name", "Value": "mcp-nat-gateway" }]
      }
    },

    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "Tags": [{ "Key": "Name", "Value": "MCP Public" }]
      }
    },

    "PublicDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "InternetGatewayAttachment",
      "Properties": {
        "RouteTableId": { "Ref": "PublicRouteTable" },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": { "Ref": "InternetGateway" }
      }
    },

    "PublicSubnet1RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "PublicRouteTable" },
        "SubnetId": { "Ref": "PublicSubnet1" }
      }
    },

    "PublicSubnet2RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "PublicRouteTable" },
        "SubnetId": { "Ref": "PublicSubnet2" }
      }
    },

    "PublicSubnet3RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "PublicRouteTable" },
        "SubnetId": { "Ref": "PublicSubnet3" }
      }
    },

    "PrivateRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "Tags": [{ "Key": "Name", "Value": "MCP Private" }]
      }
    },

    "PrivateDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": { "Ref": "PrivateRouteTable" },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": { "Ref": "NatGateway" }
      }
    },

    "PrivateSubnet1RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "PrivateRouteTable" },
        "SubnetId": { "Ref": "PrivateSubnet1" }
      }
    },

    "PrivateSubnet2RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "PrivateRouteTable" },
        "SubnetId": { "Ref": "PrivateSubnet2" }
      }
    },

    "PrivateSubnet3RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "PrivateRouteTable" },
        "SubnetId": { "Ref": "PrivateSubnet3" }
      }
    }
  },

  "Outputs": {
    "VpcId": {
      "Description": "VPC id",
      "Value": { "Ref": "Vpc" },
      "Export": { "Name": { "Fn::Sub": "${AWS::StackName}-VpcId" } }
    },
    "PublicSubnetIds": {
      "Description": "Comma separated public subnet ids (for internet facing load balancers)",
      "Value": {
        "Fn::Join": [",", [
          { "Ref": "PublicSubnet1" },
          { "Ref": "PublicSubnet2" },
          { "Ref": "PublicSubnet3" }
        ]]
      },
      "Export": { "Name": { "Fn::Sub": "${AWS::StackName}-PublicSubnetIds" } }
    },
    "PrivateSubnetIds": {
      "Description": "Comma separated private subnet ids (for EKS worker nodes)",
      "Value": {
        "Fn::Join": [",", [
          { "Ref": "PrivateSubnet1" },
          { "Ref": "PrivateSubnet2" },
          { "Ref": "PrivateSubnet3" }
        ]]
      },
      "Export": { "Name": { "Fn::Sub": "${AWS::StackName}-PrivateSubnetIds" } }
    },
    "NatGatewayPublicIp": {
      "Description": "Egress IP for all private subnet traffic - allowlist this on external services",
      "Value": { "Ref": "NatEip" },
      "Export": { "Name": { "Fn::Sub": "${AWS::StackName}-NatEip" } }
    }
  }
}
